// Example for StoreInvoiceRequest.php
public function rules()
{
    return [
        'quarry_id' => ['required', 'exists:quarries,id'],
        'invoice_type' => ['required', 'string', 'in:Postpaid,cash'],
        'customer_id' => ['required', 'exists:customer_accounts,id'],
        'customer_car_id' => ['required', 'exists:cars,id'],
        'contractor_id' => ['nullable', 'exists:car_contractors,id'],
        'custody' => ['nullable', 'numeric', 'min:0', 'max:999999999999'],
        'the_items' => ['required', 'string', 'in:رمال,تربه,زلط,رديم'],
        // More validation rules...
    ];
}
