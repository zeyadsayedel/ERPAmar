// Example for InvoiceResource.php
public function toArray($request)
{
    return [
        'id' => $this->id,
        'cashier' => $this->whenLoaded('cashier', function () {
            return new UserResource($this->cashier);
        }),
        'quarry' => $this->whenLoaded('quarry', function () {
            return new QuarryResource($this->quarry);
        }),
        'invoice_type' => $this->invoice_type,
        'customer' => $this->whenLoaded('customer', function () {
            return new CustomerAccountResource($this->customer);
        }),
        // More fields and relations...
        'created_at' => $this->created_at,
        'updated_at' => $this->updated_at,
    ];
}
